# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf
*.pyw text eol=lf

# JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.pyc binary
*.pyo binary
*.mpy binary
*.uf2 binary

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
